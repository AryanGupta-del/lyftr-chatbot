# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-key,your-second-key
# Any LiteLLM model name that matches your keys' provider.
LLM_MODEL=gemini/gemini-3.5-flash
# SQLite file lives on the Docker volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (your frontend URL(s)).
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure test header.
ENABLE_FAILURE_SIMULATION=true
# true = no real LLM calls (offline demo/tests).
MOCK_LLM=false
# Backend URL the frontend calls (baked in at build time).
VITE_API_URL=http://localhost:8000
